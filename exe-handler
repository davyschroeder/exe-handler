#!/usr/bin/env python3
"""exe-handler: open a Windows or DOS program on Linux with the right tool.

It reads the file header instead of guessing from the name:
  64-bit Windows (PE32+)            -> Wine            (on ARM: Wine via Box64)
  32-bit Windows (PE32)             -> Wine            (on ARM: Wine via Box64, WoW64)
  16-bit Windows (NE)               -> Wine; on ARM via otvdm (emulates the 16-bit CPU)
  DOS (MZ, LE/LX extenders, .com)   -> DOSBox-X (or DOSBox)
  .msi                              -> Wine msiexec
  .bat                              -> DOSBox-X
Console programs open in a terminal window. Everything is logged to ~/.cache/exe-handler.log.

Usage: exe-handler [--dos|--wine] FILE [args...]
       exe-handler --check FILE     show what exe-handler would do with FILE, without starting it
       exe-handler --warmup         get Wine ready in the background (run at login, so programs start smoothly)

Per program (optional, put next to the .exe):
  exe-handler.start   lines "A.exe = B.exe": start B.exe when A.exe is opened (e.g. a mod loader)
  exe-handler.reg     registry file imported before every start
Per user (optional):
  ~/.config/exe-handler/virtual-desktop.conf   "game.exe 1024x768": run inside a Wine virtual desktop window
  ~/.config/exe-handler/x11.conf               "game.exe": use Wine's X11 driver on a Wayland desktop
  ~/.config/exe-handler/dos.conf               DOSBox-X settings (created on first DOS start)
System settings (written by install.sh): /etc/exe-handler.conf
"""
import os, re, shlex, shutil, struct, subprocess, sys, time

HOME = os.path.expanduser("~")
CONF = os.environ.get("EXE_HANDLER_CONF", "/etc/exe-handler.conf")
USER_DIR = f"{HOME}/.config/exe-handler"
LOG = f"{HOME}/.cache/exe-handler.log"
NL = os.environ.get("LANG", "").startswith("nl") or os.environ.get("LANGUAGE", "").startswith("nl")


def T(en, nl):
    return nl if NL else en


def settings():
    """KEY=value lines from /etc/exe-handler.conf (values are shell-style words)."""
    s = {"WINE": "wine", "DOSBOX": "dosbox-x", "OTVDM": "", "ARCH": os.uname().machine}
    try:
        for line in open(CONF):
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                k, v = line.split("=", 1)
                s[k.strip()] = v.strip().strip('"')
    except OSError:
        pass
    return s


S = settings()
WINE = shlex.split(S["WINE"])          # e.g. ["wine"] or ["box64", "/opt/exe-handler/wine/bin/wine"]
DOSBOX = shlex.split(S["DOSBOX"])      # e.g. ["dosbox-x"], ["flatpak", "run", "com.dosbox_x.DOSBox-X"], ["dosbox"]
OTVDM = S["OTVDM"]                     # folder with otvdm (16-bit Windows on ARM), empty on x86
IS_X86 = S["ARCH"] in ("x86_64", "i686", "i386", "amd64")


def log(msg):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as f:
        f.write(time.strftime("%F %T ") + msg + "\n")


def has_display():
    return bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))


def tell(msg, error=False):
    """Message in a dialog (also when started from the file manager), else on the terminal."""
    log(("ERROR: " if error else "") + msg)
    if has_display():
        for tool, args in (("zenity", ["--error" if error else "--info", "--no-wrap", "--title=exe-handler", f"--text={msg}"]),
                           ("kdialog", ["--error" if error else "--msgbox", msg, "--title", "exe-handler"]),
                           ("notify-send", ["exe-handler", msg])):
            if shutil.which(tool):
                subprocess.run([tool] + args, stderr=subprocess.DEVNULL)
                return
    print(msg, file=sys.stderr)


def kind(path):
    """('win64'|'win32'|'win16'|'dos'|'msi'|'bat', console: bool)"""
    ext = os.path.splitext(path)[1].lower()
    if ext == ".msi":
        return "msi", False
    if ext == ".bat":
        return "bat", True
    with open(path, "rb") as f:
        head = f.read(64)
        if head[:2] not in (b"MZ", b"ZM"):
            return "dos", True                      # headerless .com image
        off = struct.unpack("<I", head[60:64])[0] if len(head) >= 64 else 0
        f.seek(off)
        sig = f.read(4)
        if sig == b"PE\0\0":
            coff = f.read(20)
            machine = struct.unpack("<H", coff[0:2])[0]
            opt = f.read(70)
            magic = struct.unpack("<H", opt[0:2])[0]
            subsystem = struct.unpack("<H", opt[68:70])[0] if len(opt) >= 70 else 2
            console = subsystem == 3
            if magic == 0x20B or machine in (0x8664, 0xAA64):
                return "win64", console
            return "win32", console
        if sig[:2] == b"NE":
            return "win16", False
        return "dos", True                          # plain MZ, LE/LX (DOS extenders)


def pe_os_version(path):
    """(major, minor) OS version the program was built for (PE subsystem version), or None."""
    try:
        with open(path, "rb") as f:
            h = f.read(64)
            f.seek(struct.unpack("<I", h[60:64])[0])
            if f.read(4) != b"PE\0\0":
                return None
            f.read(20)
            opt = f.read(52)
            return struct.unpack("<HH", opt[48:52])
    except (OSError, struct.error):
        return None


def pe_imports(path):
    """Names of the DLLs a Windows program imports directly (lower case), or [] when it cannot be read."""
    try:
        with open(path, "rb") as f:
            data = f.read(64 * 1024 * 1024)
        pe = struct.unpack("<I", data[60:64])[0]
        if data[pe:pe + 4] != b"PE\0\0":
            return []
        nsect, optsize = struct.unpack("<H", data[pe + 6:pe + 8])[0], struct.unpack("<H", data[pe + 20:pe + 22])[0]
        opt = pe + 24
        magic = struct.unpack("<H", data[opt:opt + 2])[0]
        ddir = opt + (112 if magic == 0x20B else 96)
        imp_rva = struct.unpack("<I", data[ddir + 8:ddir + 12])[0]
        sections = []
        for i in range(nsect):
            sh = opt + optsize + 40 * i
            vsize, va, rawsize, raw = struct.unpack("<IIII", data[sh + 8:sh + 24])
            sections.append((va, max(vsize, rawsize), raw))

        def off(rva):
            for va, size, raw in sections:
                if va <= rva < va + size:
                    return rva - va + raw
            return None
        o, names = off(imp_rva), []
        while o is not None and o + 20 <= len(data):
            name_rva = struct.unpack("<I", data[o + 12:o + 16])[0]
            if not name_rva:
                break
            n = off(name_rva)
            if n is not None:
                names.append(data[n:data.index(b"\0", n)].decode("ascii", "replace").lower())
            o += 20
        return names
    except (OSError, struct.error, ValueError):
        return []


def wine_builtin_dirs(win64):
    """Folders with Wine's own Windows DLLs (i386-windows or x86_64-windows) for the Wine that exe-handler uses."""
    sub = "x86_64-windows" if win64 else "i386-windows"
    exe = shutil.which(WINE[-1]) or WINE[-1]
    base = os.path.dirname(os.path.realpath(exe))
    cands = [os.path.join(base, "..", lib, "wine", sub) for lib in ("lib", "lib64", "lib32")]
    cands += [f"/usr/lib/wine/{sub}", f"/usr/lib64/wine/{sub}", f"/usr/lib/i386-linux-gnu/wine/{sub}",
              f"/usr/lib/x86_64-linux-gnu/wine/{sub}"]
    return [os.path.normpath(c) for c in cands if os.path.isdir(c)]


def missing_dlls(path, e):
    """DLLs the program imports that are neither next to it, nor in the Wine folder, nor built into Wine.
    Old programs often relied on a DLL that Windows 95/98 or another program had put in C:\\WINDOWS\\SYSTEM
    (MFC30.DLL, CNCS32.DLL, VBRUN300.DLL); Wine then stops right away without saying which one."""
    k = kind(path)[0]
    if k not in ("win32", "win64"):
        return []
    builtin = wine_builtin_dirs(k == "win64")
    if not builtin:
        return []                                   # cannot tell what Wine brings itself: say nothing
    win = os.path.join(e["WINEPREFIX"], "drive_c", "windows")
    sysdir = os.path.join(win, "system32" if k == "win64" or not os.path.isdir(os.path.join(win, "syswow64"))
                          else "syswow64")
    have = set()
    for d in [os.path.dirname(path), sysdir, win] + builtin + [x for x in e.get("WINEPATH", "").split(";") if x]:
        try:
            have.update(n.lower() for n in os.listdir(d))
        except OSError:
            pass
    return [d for d in pe_imports(path) if d not in have]


def system_dir(path, e):
    win = os.path.join(e["WINEPREFIX"], "drive_c", "windows")
    if kind(path)[0] == "win32" and os.path.isdir(os.path.join(win, "syswow64")):
        return os.path.join(win, "syswow64")
    return os.path.join(win, "system32")


def env_wine():
    e = dict(os.environ)
    e.setdefault("WINEPREFIX", f"{HOME}/.wine")
    e.setdefault("WINEDEBUG", "-all")
    e.setdefault("BOX64_LOG", "0")
    e.setdefault("BOX64_NOBANNER", "1")
    return e


def own_prefix(path):
    """A program installed inside a Wine folder (.../drive_c/...) runs in that Wine folder: its installer put the
    DLLs and registry entries it needs there (e.g. MFC30.DLL in windows/system). Only a Wine folder you may write
    to; WINEPREFIX set by the caller always wins."""
    if "WINEPREFIX" in os.environ:
        return
    parts = path.split(os.sep)
    for i in range(len(parts) - 1, 0, -1):
        if parts[i].lower() == "drive_c":
            pfx = os.sep.join(parts[:i])
            if os.path.isfile(os.path.join(pfx, "system.reg")) and os.access(pfx, os.W_OK):
                if os.path.realpath(pfx) != os.path.realpath(f"{HOME}/.wine"):
                    log(f"program lives in Wine folder {pfx}: using that one")
                os.environ["WINEPREFIX"] = pfx
            return


def wine(*args, e=None, timeout=300):
    return subprocess.run(WINE + list(args), env=e or env_wine(), stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, timeout=timeout)


def wineserver_cmd():
    """The wineserver that belongs to WINE: next to a wine given by path (ARM: via box64), else from PATH."""
    if "/" in WINE[-1]:
        return WINE[:-1] + [os.path.join(os.path.dirname(WINE[-1]), "wineserver")]
    return ["wineserver"] if shutil.which("wineserver") else None


def keep_wine_ready(e, warm=False):
    """Start a wineserver that stays (-p). When Wine starts from nothing it reads all monitors again a dozen
    times; on a multi-monitor desktop every read freezes the screen for a moment (2 seconds of stutter in total
    on a three-monitor laptop). With a wineserver that stays this happens once, not at every program start.
    warm=True (exe-handler --warmup, run at login) also does that first read right away."""
    ws = wineserver_cmd()
    if not ws or not os.path.exists(os.path.join(e["WINEPREFIX"], "system.reg")):
        return
    try:
        subprocess.run(ws + ["-p"], env=e, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        if warm:
            wine("cmd", "/c", "exit", e=e, timeout=120)
            log("warmup: wineserver stays ready")
    except (OSError, subprocess.TimeoutExpired):
        pass


def page_size_ok():
    if IS_X86 or os.sysconf("SC_PAGE_SIZE") == 4096:
        return True
    tell(T("Wine does not work with this kernel (16K memory pages).\n"
           "On a Raspberry Pi 5: add the line  kernel=kernel8.img  to /boot/firmware/config.txt and reboot.",
           "Wine werkt niet met deze kernel (16K-geheugenpagina's).\n"
           "Op een Raspberry Pi 5: zet de regel  kernel=kernel8.img  in /boot/firmware/config.txt en herstart."),
         error=True)
    return False


WINDOW_REG = r"""REGEDIT4

[HKEY_CURRENT_USER\Software\Wine\X11 Driver]
"Decorated"="Y"
"Managed"="Y"
"GrabFullscreen"="N"
"UseXRandR"="Y"
"EmulateModeset"="Y"

[HKEY_CURRENT_USER\Software\Wine\DirectInput]
"MouseWarpOverride"="enable"
"""


WINDOW_REG_VERSION = 4      # raise when WINDOW_REG changes: it is then imported again into existing Wine folders


def window_settings(e):
    """Import WINDOW_REG once per Wine folder (also into one that existed before exe-handler was installed):
    title bar from the desktop (maximise/minimise/close work), no mouse grab in fullscreen (Alt+Tab works), and
    EmulateModeset (Wine 10+): a game that switches to 640x480 gets a scaled picture, the real monitor keeps its
    resolution. Without it an old fullscreen game changes the monitor and rearranges a multi-monitor desktop."""
    import hashlib
    mark = os.path.join(USER_DIR, f"window-v{WINDOW_REG_VERSION}-{hashlib.sha1(e['WINEPREFIX'].encode()).hexdigest()[:8]}")
    if os.path.exists(mark):
        return
    os.makedirs(USER_DIR, exist_ok=True)
    reg = os.path.join(USER_DIR, "window.reg")
    with open(reg, "w") as f:
        f.write(WINDOW_REG)
    wine("regedit", "/S", "Z:" + reg.replace("/", "\\"), e=e)
    open(mark, "w").close()
    log(f"window settings v{WINDOW_REG_VERSION} imported into {e['WINEPREFIX']}")


def monitors():
    """{output: (mode, position, rate)} of the active monitors, from xrandr; {} when unknown."""
    if not (os.environ.get("DISPLAY") and shutil.which("xrandr")):
        return {}
    out, cur = {}, None
    try:
        text = subprocess.run(["xrandr", "--current"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    for line in text.splitlines():
        w = line.split()
        if len(w) > 2 and w[1] == "connected":
            geo = next((x for x in w[2:5] if "x" in x and "+" in x), None)
            cur = w[0] if geo else None
            if geo:
                mode, x, y = geo.split("+")
                out[cur] = [mode, f"{x}x{y}", None, "primary" in w[2:4]]
        elif cur and line.startswith("   ") and "*" in line:
            out[cur][2] = next((x.strip("*+") for x in w[1:] if "*" in x), None)
            cur = None
    return out


def restore_monitors(before):
    """Safety net: a game that crashed (or was killed) in fullscreen can leave a monitor at 640x480."""
    after = monitors()
    if not before or after == before:
        return
    cmd = ["xrandr"]
    for name, (mode, pos, rate, primary) in before.items():
        cmd += ["--output", name, "--mode", mode, "--pos", pos] + (["--rate", rate] if rate else []) + \
               (["--primary"] if primary else [])
    log("monitor layout changed by the program, restoring: " + shlex.join(cmd))
    subprocess.run(cmd, stderr=subprocess.DEVNULL)


def prefix_ready(e):
    """Create the Wine folder (prefix) on first use."""
    k32 = os.path.join(e["WINEPREFIX"], "drive_c/windows/system32/kernel32.dll")
    if os.path.exists(k32):
        window_settings(e)
        return True
    log(f"creating Wine prefix {e['WINEPREFIX']}")
    if has_display():
        subprocess.Popen(["zenity", "--info", "--no-wrap", "--timeout=20", "--title=exe-handler",
                          "--text=" + T("Preparing Wine (first start only, takes a minute)...",
                                        "Wine wordt klaargezet (alleen de eerste keer, duurt een minuut)...")],
                         stderr=subprocess.DEVNULL) if shutil.which("zenity") else None
    wine("wineboot", "-u", e=e, timeout=900)
    if os.path.exists(k32):
        window_settings(e)
    return os.path.exists(k32)


def terminal(cmd):
    """Run a console program in a terminal window that stays open afterwards."""
    inner = f"{shlex.join(cmd)}; echo; read -n1 -rsp '{T('Done. Press a key to close...', 'Klaar. Druk op een toets om te sluiten...')}'"
    for t, flag in (("x-terminal-emulator", "-e"), ("gnome-terminal", "--"), ("konsole", "-e"),
                    ("xfce4-terminal", "-x"), ("lxterminal", "-e"), ("mate-terminal", "-x"), ("xterm", "-e")):
        if shutil.which(t):
            return [t, flag, "bash", "-c", inner]
    return cmd


def auto_settings(path, e):
    """Once per program: programs built for Windows 95-XP get Windows version 'winxp' (fewer setup errors)."""
    done_file = os.path.join(USER_DIR, "auto-done.txt")
    key = f"{e['WINEPREFIX']}|{os.path.basename(path).lower()}"
    try:
        done = set(l.strip() for l in open(done_file))
    except OSError:
        done = set()
    if key in done:
        return
    ver = pe_os_version(path)
    if ver and ver[0] < 6:
        wine("reg", "add", f"HKCU\\Software\\Wine\\AppDefaults\\{os.path.basename(path)}", "/v", "Version",
             "/t", "REG_SZ", "/d", "winxp", "/f", e=e)
        log(f"auto: {os.path.basename(path)} built for Windows {ver[0]}.{ver[1]} -> winxp")
    os.makedirs(USER_DIR, exist_ok=True)
    with open(done_file, "a") as f:
        f.write(key + "\n")


def next_to(path, *names):
    for n in names:
        p = os.path.join(os.path.dirname(path), n)
        if os.path.exists(p):
            return p
    return None


def primary_screen():
    """'WIDTHxHEIGHT' of the primary monitor (else the first one, else the whole desktop), e.g. '2560x1440'."""
    mons = monitors()
    for name, (mode, pos, rate, primary) in mons.items():
        if primary:
            return mode
    if mons:
        return next(iter(mons.values()))[0]
    size = screen_size()
    return f"{size[0]}x{size[1]}" if size else "1920x1080"


def start_line(path):
    """exe-handler.start next to the program. Lines 'A.exe = B.exe [options]': opening A starts B with those
    options; '{screen}' in the options becomes the primary monitor's resolution, e.g.
        StarTopia.exe = StarTopia.exe /r{screen}x32
    Returns (program, [options])."""
    f = next_to(path, "exe-handler.start", "run-exe.start")
    if f:
        for line in open(f, errors="replace"):
            if "=" in line and not line.lstrip().startswith(("#", ";")):
                a, b = (x.strip() for x in line.split("=", 1))
                if a.lower() != os.path.basename(path).lower():
                    continue
                d = os.path.dirname(path)
                if os.path.exists(os.path.join(d, b)):              # a name with spaces and no options
                    name, opts = b, []
                else:
                    name, _, rest = b.partition(" ")
                    opts = [o.replace("{screen}", primary_screen()) for o in rest.split()]
                target = os.path.join(d, name)
                if os.path.exists(target):
                    log(f"exe-handler.start: {a} -> {name} {' '.join(opts)}".rstrip())
                    return target, opts
    return path, []


def alias(path):
    return start_line(path)[0]


def listed(name, path):
    """Is this program named in ~/.config/exe-handler/<name> (one exe name per line)?"""
    try:
        names = [l.split("#")[0].strip().lower() for l in open(os.path.join(USER_DIR, name))]
    except OSError:
        return False
    return os.path.basename(path).lower() in names


def virtual_desktop(path):
    try:
        for line in open(os.path.join(USER_DIR, "virtual-desktop.conf")):
            parts = line.split("#")[0].split()
            if len(parts) == 2 and parts[0].lower() == os.path.basename(path).lower():
                return parts[1]
    except OSError:
        pass
    return None


VB_LIMIT = 32767 // 15          # 2184 pixels: Visual Basic keeps screen sizes in twips (15 per pixel) in 16 bits
VB_RUNTIMES = (b"vbrun100", b"vbrun200", b"vbrun300", b"vb40016", b"vb40032", b"msvbvm50", b"msvbvm60")


def is_visual_basic(path):
    """The program uses a Visual Basic runtime: named inside the .exe, or the runtime DLL lies next to it."""
    try:
        with open(path, "rb") as f:
            data = f.read(4 * 1024 * 1024).lower()
        if any(r in data for r in VB_RUNTIMES):
            return True
    except OSError:
        pass
    try:
        here = [n.lower() for n in os.listdir(os.path.dirname(path))]
    except OSError:
        return False
    return any(n.startswith(r.decode()) and n.endswith(".dll") for n in here for r in VB_RUNTIMES)


def runtime_in_parent(path):
    """Shareware CDs often keep one copy of the Visual Basic runtime (VBRUN300.DLL ...) in the folder above the
    games. Windows found it through its own system folder; give Wine that parent folder as an extra search path."""
    d = os.path.dirname(path)
    up = os.path.dirname(d)
    try:
        here = {n.lower() for n in os.listdir(d)}
        above = [n.lower() for n in os.listdir(up)]
    except OSError:
        return None
    vb = [n for n in above if n.endswith(".dll") and any(n.startswith(r.decode()) for r in VB_RUNTIMES)]
    return up if vb and not any(n in here for n in vb) else None


def win16_runtimes(folder, e):
    """16-bit programs run in otvdm, which does not search WINEPATH. Windows 3.1 kept the Visual Basic runtimes in
    C:\\WINDOWS\\SYSTEM: copy the ones from the folder above the program there (once, never overwriting)."""
    sysdir = os.path.join(e["WINEPREFIX"], "drive_c", "windows", "system")
    try:
        os.makedirs(sysdir, exist_ok=True)
        have = {n.lower() for n in os.listdir(sysdir)}
        for n in os.listdir(folder):
            low = n.lower()
            if low.endswith(".dll") and any(low.startswith(r.decode()) for r in VB_RUNTIMES) and low not in have:
                shutil.copy2(os.path.join(folder, n), os.path.join(sysdir, n))
                log(f"Visual Basic runtime {n} from {folder} copied to C:\\windows\\system (16-bit program)")
    except OSError as err:
        log(f"could not copy the Visual Basic runtime from {folder} ({err})")


def ne_imports(path):
    """Module names a 16-bit (NE) program links to, plus DLL/VBX file names written in it (loaded at run time,
    e.g. Visual Basic controls such as THREED.VBX). Lower case, with extension: ['bwcc.dll', 'threed.vbx']."""
    try:
        with open(path, "rb") as f:
            data = f.read(4 * 1024 * 1024)
        ne = struct.unpack_from("<I", data, 0x3C)[0]
        if data[ne:ne + 2] != b"NE":
            return []
        count, modtab, names = struct.unpack_from("<H", data, ne + 0x1E)[0], *struct.unpack_from("<HH", data, ne + 0x28)
        out = []
        for i in range(count):
            off = ne + names + struct.unpack_from("<H", data, ne + modtab + 2 * i)[0]
            out.append(data[off + 1:off + 1 + data[off]].decode("latin-1").lower() + ".dll")
    except (OSError, struct.error, IndexError):
        return []
    out += [m.decode("latin-1").lower() for m in re.findall(rb"(?i)\b[a-z0-9_$~-]{1,8}\.(?:dll|vbx)\b", data)]
    return list(dict.fromkeys(out))


def win16_shared(path, e):
    """Windows 3.1 programs counted on shared DLLs and Visual Basic controls (BWCC.DLL, CTL3DV2.DLL, VBRUN300.DLL,
    THREED.VBX) being in C:\\WINDOWS\\SYSTEM, put there by whatever was installed before. On shareware CDs they
    come with one game and are missing next to the others. When the program needs one that is not next to it, not
    in the Wine folder and not built into Wine/otvdm, look in the folder above and in the folders next to the
    program's folder, and copy it (once, never overwriting) to C:\\windows\\system, as Windows 3.1 had it."""
    sysdir = os.path.join(e["WINEPREFIX"], "drive_c", "windows", "system")
    here = os.path.dirname(path)
    up = os.path.dirname(here)

    def names(d):
        try:
            return {n.lower(): n for n in os.listdir(d)}
        except OSError:
            return {}
    have = set(names(here)) | set(names(sysdir)) | set(names(os.path.join(e["WINEPREFIX"], "drive_c", "windows")))
    provided = set()
    for d in wine_builtin_dirs(False) + ([os.path.join(OTVDM, "dll")] if OTVDM else []):
        provided |= {n.lower()[:-2] for n in names(d) if n.lower().endswith(("16", ".dll"))}
        provided |= {n.lower() for n in names(d)}
    wanted = [n for n in ne_imports(path) if n not in have and n not in provided and n[:-4] + ".dll16" not in provided
              and n[:-4] not in ("kernel", "user", "gdi", "krnl386", "system", "keyboard", "sound", "toolhelp")]
    if not wanted:
        return
    places = [up] + sorted(os.path.join(up, d) for d in names(up).values() if os.path.isdir(os.path.join(up, d))
                           and os.path.join(up, d) != here)
    for n in wanted:
        for d in places:
            src = names(d).get(n)
            if src:
                try:
                    os.makedirs(sysdir, exist_ok=True)
                    shutil.copy2(os.path.join(d, src), os.path.join(sysdir, src.upper()))
                    log(f"16-bit program needs {n.upper()}: copied from {d} to C:\\windows\\system")
                except OSError as err:
                    log(f"could not copy {n.upper()} from {d} ({err})")
                break
        else:
            log(f"16-bit program names {n.upper()}, which is nowhere near it (it may not need it)")


def screen_size():
    """Total desktop size in pixels (all monitors together), or None.
    xrandr (X11 and XWayland), then xdpyinfo, then the monitors the kernel reports (also without X)."""
    if os.environ.get("DISPLAY"):
        if shutil.which("xrandr"):
            r = subprocess.run(["xrandr", "--current"], capture_output=True, text=True)
            for line in r.stdout.splitlines():
                if " current " in line:
                    part = line.split(" current ")[1].split(",")[0].split(" x ")
                    try:
                        return int(part[0]), int(part[1])
                    except (ValueError, IndexError):
                        pass
        if shutil.which("xdpyinfo"):
            r = subprocess.run(["xdpyinfo"], capture_output=True, text=True)
            for line in r.stdout.splitlines():
                if "dimensions:" in line:
                    try:
                        w, h = line.split()[1].split("x")
                        return int(w), int(h)
                    except (ValueError, IndexError):
                        pass
    # kernel: every connected monitor's preferred mode, side by side
    w = h = 0
    for status in __import__("glob").glob("/sys/class/drm/card*-*/status"):
        try:
            if open(status).read().strip() != "connected":
                continue
            mode = open(os.path.join(os.path.dirname(status), "modes")).readline().strip()
            mw, mh = (int(x) for x in mode.split("x")[:2])
            w, h = w + mw, max(h, mh)
        except (OSError, ValueError):
            pass
    return (w, h) if w else None


def auto_desktop(path):
    """Old Visual Basic programs (VB3-VB6) store screen sizes in twips (15 per pixel) in 16-bit integers and crash
    with 'Run-time error 6: Overflow' on wide screens or multi-monitor desktops. Measuring the screen is not reliable
    everywhere (Wayland, several monitors, a primary monitor that is not the widest), so they always run inside a
    Wine virtual desktop window of 1600x900, or smaller when the screen is smaller."""
    if not is_visual_basic(path):
        return None
    size = screen_size()
    if size and size[0] <= VB_LIMIT and size[1] <= VB_LIMIT:
        return None                     # the whole desktop is small enough: no overflow possible, run it directly
    w, h = 1600, 900
    if size:
        w, h = min(w, size[0] - 40), min(h, size[1] - 80)
    log(f"Visual Basic program (desktop {size[0]}x{size[1]}) -> virtual desktop {w}x{h}" if size
        else f"Visual Basic program (screen size unknown) -> virtual desktop {w}x{h}")
    return f"{w}x{h}"


def desktop_windows(desk):
    """Visible program windows inside a Wine virtual desktop window: [(id, x, y, w, h)]."""
    import re
    try:
        out = subprocess.run(["xwininfo", "-id", desk, "-children"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    if "Parent window id" not in out:
        return None                                   # the desktop window is gone
    wins = []
    for m in re.finditer(r'^\s+(0x[0-9a-f]+) "([^"]+)": \(.*?\)\s+(\d+)x(\d+)\+(-?\d+)\+(-?\d+)', out, re.M):
        wid, title, w, h, x, y = m.group(1), m.group(2), *map(int, m.groups()[2:])
        if w < 50 or h < 50 or title == "Default IME":
            continue
        info = subprocess.run(["xwininfo", "-id", wid], capture_output=True, text=True).stdout
        if "IsViewable" in info:
            wins.append((wid, x, y, w, h))
    return wins


WINE_BORDER, WINE_CAPTION = 3, 25      # pixels of Wine's own window border and title bar (default theme, 96 dpi)


def wine_frame(wid, w, maximised):
    """(border, title bar height incl. top border) in pixels of a Wine-drawn window, measured from its picture:
    the title bar is the blue band at the top. Needs ImageMagick's import; else the default theme's sizes."""
    guess = (0, WINE_CAPTION + 2) if maximised else (WINE_BORDER, WINE_CAPTION)
    if not shutil.which("import"):
        return guess[0], guess[1]

    def pixels(crop):
        try:
            out = subprocess.run(["import", "-window", wid, "-crop", crop, "+repage", "txt:-"],
                                 capture_output=True, text=True, timeout=10).stdout
        except (OSError, subprocess.TimeoutExpired):
            return []
        px = []
        for line in out.splitlines():
            hx = next((t for t in line.split() if t.startswith("#")), None)
            if hx and len(hx) in (7, 9, 13, 17):
                n = (len(hx) - 1) // (3 if len(hx) in (7, 13) else 4)
                px.append(tuple(int(hx[1 + i * n:3 + i * n], 16) for i in range(3)))
        return px

    def blue(p):
        return p[2] > 140 and p[2] - p[0] > 60

    col = pixels(f"1x70+{max(w - 80, w // 2)}+0")          # a column right of the title text, left of the buttons
    rows = [i for i, p in enumerate(col) if blue(p)]
    if not rows or rows[0] > 12:
        return guess[0], guess[1]
    top, end = rows[0], rows[0]
    for i in rows:
        if i > end + 2:
            break
        end = i
    row = pixels(f"30x1+0+{(top + end) // 2}")
    left = next((i for i, p in enumerate(row) if blue(p)), 0 if maximised else WINE_BORDER)
    cap = end + 1
    # a normal window has one more line between title bar and contents; keep the border below/right as on the left
    log(f"Wine window frame measured: border {left}, title bar rows {top}-{end}")
    return left, cap - left + (1 if not maximised and left else 0)


def fit_desktop(name, size, fit=True):
    """A Wine virtual desktop (used for Visual Basic programs, see auto_desktop) as a tidy normal window.
    Wine 10 shows it borderless and fullscreen on one monitor with the program in a corner. This gives it a title
    bar again and makes it exactly as large as the program's window, so it looks like one window that can be
    dragged, minimised and closed. When the program opens another or a larger window, the desktop goes back to its
    full size first and is fitted again. Needs wmctrl, xwininfo and xdotool on X11; without them nothing happens."""
    if not (os.environ.get("DISPLAY") and shutil.which("wmctrl")):
        return
    import threading
    can_fit = fit and bool(shutil.which("xwininfo") and shutil.which("xdotool"))

    def wm(*a):
        subprocess.run(["wmctrl", "-i", "-r", desk] + list(a), stderr=subprocess.DEVNULL)

    def work():
        nonlocal desk
        title = f"{name} - Wine Desktop"
        for _ in range(60):
            time.sleep(0.5)
            try:
                rows = subprocess.run(["wmctrl", "-l"], capture_output=True, text=True, timeout=5).stdout.splitlines()
            except (OSError, subprocess.TimeoutExpired):
                return
            ids = [r.split()[0] for r in rows if r.rstrip().endswith(title)]
            if ids:
                desk = ids[0]
                break
        else:
            return
        full = tuple(int(x) for x in size.split("x"))
        time.sleep(1.5)
        wm("-b", "remove,fullscreen")
        time.sleep(1)
        wm("-e", f"0,-1,-1,{full[0]},{full[1]}")
        log(f"virtual desktop window {desk} is a normal {size} window now")
        if not can_fit:
            return
        cur, last, stable, fits = full, None, 0, 0
        while fits < 8:
            time.sleep(1)
            wins = desktop_windows(desk)
            if wins is None:
                return
            if not wins:
                continue
            sig = sorted(wins)
            if sig != last:
                last, stable = sig, 0
                if cur != full:                       # something changed after fitting: give the program room again
                    wm("-e", f"0,-1,-1,{full[0]},{full[1]}")
                    cur = full
                continue
            stable += 1
            if stable != 2 or cur != full:
                continue
            if len(wins) == 1:
                # one window: slide Wine's own title bar and border (measured) out of sight, the desktop's title bar
                # (drag, minimise, close) is enough. A maximised window has no border, only the title bar.
                wid, x, y, w, h = wins[0]
                b, cap = wine_frame(wid, w, (w, h) == full)
                subprocess.run(["xdotool", "windowmove", wid, str(-b), str(-b - cap)], stderr=subprocess.DEVNULL)
                time.sleep(0.5)
                target = (w - 2 * b, h - 2 * b - cap)
            else:
                target = (max(x + w for _, x, y, w, h in wins), max(y + h for _, x, y, w, h in wins))
            target = (min(target[0], full[0]), min(target[1], full[1]))
            if target != cur:
                wm("-e", f"0,-1,-1,{target[0]},{target[1]}")
                cur, fits = target, fits + 1
                time.sleep(1)
                last = sorted(desktop_windows(desk) or [])
                log(f"virtual desktop fitted to the program window: {target[0]}x{target[1]}")

    desk = None
    threading.Thread(target=work, daemon=True).start()


CNC_DDRAW = os.environ.get("EXE_HANDLER_CNC", "/opt/exe-handler/cnc-ddraw")       # ddraw.dll from https://github.com/FunkyFr3sh/cnc-ddraw (install.sh)
CNC_MARK = "; written by exe-handler"
CNC_INI = CNC_MARK + """ (delete this file and ddraw.dll, or create exe-handler.no-ddraw, to switch this off)
; cnc-ddraw draws old DirectDraw games in a normal window and scales the picture. The game's own low resolution
; (320x200, 640x480, 256 colours) is not asked from the monitor, which modern screens refuse.
; Maximise the window for a big picture. All settings: https://github.com/FunkyFr3sh/cnc-ddraw
[ddraw]
width=%d
height=%d
fullscreen=false
windowed=true
maintas=true
border=true
resizable=true
savesettings=0
renderer=auto
nonexclusive=true
singlecpu=true
adjmouse=true
keytogglefullscreen=0x00
"""


def old_directdraw(path):
    """A 2D-era DirectDraw game: built for Windows 95-XP, uses ddraw.dll, and is not a Direct3D (3D) game."""
    ver = pe_os_version(path)
    if not ver or ver[0] >= 6:
        return False
    try:
        with open(path, "rb") as f:
            data = f.read(8 * 1024 * 1024).lower()
    except OSError:
        return False
    if b"ddraw.dll" not in data or any(d in data for d in (b"d3d8.dll", b"d3d9.dll", b"opengl32.dll")):
        return False
    # Direct3D 5-7 games also load ddraw.dll, but draw in 3D; cnc-ddraw is for 2D games only (StarTopia broke)
    return not any(m in data for m in (b"d3dx", b"d3dim", b"direct3d device", b"iid_idirect3d", b"d3dxerr"))


def launcher_of_directdraw(path):
    """A launcher or menu (Ra2.exe starts game.exe) that does not draw with DirectDraw itself, next to an old
    DirectDraw game: settings for the game's drawing must already be in place when the launcher starts it."""
    try:
        with open(path, "rb") as f:
            if b"ddraw.dll" in f.read(8 * 1024 * 1024).lower():
                return False
        d = os.path.dirname(path)
        return any(old_directdraw(os.path.join(d, n)) for n in os.listdir(d)
                   if n.lower().endswith(".exe") and n.lower() != os.path.basename(path).lower())
    except OSError:
        return False


def ddraw_compat(path, e, cnc=True):
    """Re-releases of old games (Red Alert 2, ...) ship DDrawCompat as ddraw.dll: a fix for Windows 10/11 that
    crashes under Wine (access violation in ddraw.dll, the game stops at once). When cnc-ddraw can take over (see
    cnc_ddraw), DDrawCompat is renamed to ddraw.dll.DDrawCompat (kept, rename it back to undo); otherwise Wine's
    own DirectDraw is used for this run."""
    dll = next_to(path, "ddraw.dll", "DDRAW.dll", "DDRAW.DLL")
    if not dll:
        return e
    try:
        with open(dll, "rb") as f:
            if b"DDrawCompat" not in f.read():
                return e
    except OSError:
        return e
    keep = os.path.join(os.path.dirname(dll), "ddraw.dll.DDrawCompat")
    if cnc and os.path.exists(os.path.join(CNC_DDRAW, "ddraw.dll")) and not next_to(path, "exe-handler.no-ddraw") \
            and (old_directdraw(path) or launcher_of_directdraw(path)) and not os.path.exists(keep):
        try:
            os.rename(dll, keep)
            log(f"ddraw.dll next to the program is DDrawCompat (crashes in Wine): renamed to {keep}, cnc-ddraw instead")
            return e
        except OSError as err:
            log(f"DDrawCompat could not be renamed ({err})")
    log("ddraw.dll next to the program is DDrawCompat (crashes in Wine): Wine's own DirectDraw is used instead")
    e = dict(e)
    e["WINEDLLOVERRIDES"] = "ddraw=b" + (";" + e["WINEDLLOVERRIDES"] if e.get("WINEDLLOVERRIDES") else "")
    return e


def cnc_ddraw(path, e):
    """Old DirectDraw games ask the monitor for 320x200 or 640x480 in 256 colours. Today's screens refuse ('Could
    not set video mode'), or the whole desktop is rearranged. Put cnc-ddraw next to the game (once) and let Wine
    use it for this run: the game then lives in a scaled, resizable window. Also on ARM: cnc-ddraw is x86
    Windows code like the game itself and runs under Box64 (Red Alert 2 tested on a Raspberry Pi 5)."""
    d = os.path.dirname(path)
    dll, ini = os.path.join(d, "ddraw.dll"), os.path.join(d, "ddraw.ini")
    src = os.path.join(CNC_DDRAW, "ddraw.dll")
    if not os.path.exists(src) or next_to(path, "exe-handler.no-ddraw") or \
            not (old_directdraw(path) or launcher_of_directdraw(path)):
        return e
    ours = False
    try:
        ours = open(ini, errors="replace").readline().startswith(CNC_MARK)
    except OSError:
        pass
    if os.path.exists(dll) and not ours:
        # the game brings its own ddraw.dll (or the user placed one): leave it alone, but when it is cnc-ddraw make
        # sure Wine loads it (Wine prefers its own ddraw.dll over one next to the program)
        try:
            with open(dll, "rb") as f:
                data = f.read()
            theirs_cnc = b"cnc_ddraw_config_init" in data or b"cnc-ddraw" in data
        except OSError:
            theirs_cnc = False
        if not theirs_cnc:
            return e
        log("cnc-ddraw that was already next to the game is used")
        e = dict(e)
        e["WINEDLLOVERRIDES"] = "ddraw=n,b" + (";" + e["WINEDLLOVERRIDES"] if e.get("WINEDLLOVERRIDES") else "")
        return e
    if not ours:
        try:
            shutil.copyfile(src, dll)
            size = screen_size() or (1920, 1080)
            w, h = (1280, 960) if size[1] >= 1200 else (800, 600)
            with open(ini, "w") as f:
                f.write(CNC_INI % (w, h))
        except OSError as err:
            log(f"cnc-ddraw not placed next to the game ({err})")
            return e
        log(f"cnc-ddraw placed in {d} (old DirectDraw game: scaled window instead of a mode switch)")
    e = dict(e)
    e["WINEDLLOVERRIDES"] = "ddraw=n,b" + (";" + e["WINEDLLOVERRIDES"] if e.get("WINEDLLOVERRIDES") else "")
    return e


DXVK = os.environ.get("EXE_HANDLER_DXVK", "/opt/exe-handler/dxvk")     # x32/ and x64/ from https://github.com/doitsujin/dxvk (install.sh)
DXVK_DLLS = ("d3d8", "d3d9", "d3d10core", "d3d11", "dxgi")
DXVK_MARK = "exe-handler.dxvk"


_VULKAN = []


def vulkan_for_dxvk():
    """'gpu' when a real GPU can run DXVK, 'llvmpipe' when only Mesa's software Vulkan can (the Raspberry Pi 5's
    V3D lacks multiDrawIndirect, a feature DXVK requires), None when there is no Vulkan at all."""
    if _VULKAN:
        return _VULKAN[0]
    try:
        out = subprocess.run(["vulkaninfo"], capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        out = ""
    gpus = re.split(r"\nGPU\d+:\n", out)[1:]
    real = [g for g in gpus if "PHYSICAL_DEVICE_TYPE_CPU" not in g]
    if any(not re.search(r"multiDrawIndirect\s*=\s*(false|0)\b", g) for g in real):
        mode = "gpu"
    elif "llvmpipe" in out:
        mode = "llvmpipe"
    else:
        mode = None
    _VULKAN.append(mode)
    return mode


def direct3d_version(path):
    """Newest Direct3D a program uses: 11 (also 10 and DXGI), 9, 8 or None. Looks in the .exe and in the DLLs it
    loads from its own folder: Unity games keep their Direct3D in UnityPlayer.dll next to a small .exe."""
    d = os.path.dirname(path)
    files = [path] + [os.path.join(d, n) for n in os.listdir(d) if n.lower() == "unityplayer.dll"]
    for imp in pe_imports(path):
        f = os.path.join(d, imp)
        if imp[:-4] not in DXVK_DLLS and os.path.isfile(f) and f not in files:
            files.append(f)
    found = set()
    for f in files:
        try:
            with open(f, "rb") as fh:
                data = fh.read(64 * 1024 * 1024).lower()
        except OSError:
            continue
        if b"d3d11.dll" in data or b"dxgi.dll" in data or b"d3d10.dll" in data or b"d3d10_1.dll" in data:
            found.add(11)
        if b"d3d9.dll" in data:
            found.add(9)
        if b"d3d8.dll" in data:
            found.add(8)
    return max(found) if found else None


def dxvk(path, e):
    """DXVK (Direct3D 8-11 via Vulkan) instead of Wine's own OpenGL-based Direct3D, chosen automatically:
    Direct3D 10/11 programs always get it (Wine's own cannot start Unity games on the Pi: 'failed to create
    device'), Direct3D 8/9 programs only when a real GPU runs DXVK (on llvmpipe Wine's own is faster).
    dxvk.conf forces it on, no-dxvk.conf or a file exe-handler.no-dxvk next to the program forces it off.
    DXVK's DLLs are placed next to the program (once) and Wine prefers them for this run."""
    d = os.path.dirname(path)
    mark = os.path.join(d, DXVK_MARK)
    ours = set()
    try:
        ours = {l.strip() for l in open(mark) if l.strip() and not l.startswith("#")}
    except OSError:
        pass
    forced = listed("dxvk.conf", path)
    use, why = False, ""
    if not (listed("no-dxvk.conf", path) or next_to(path, "exe-handler.no-dxvk")):
        ver = direct3d_version(path)
        mode = vulkan_for_dxvk() if (ver or forced) else None
        if mode and (forced or ver == 11 or mode == "gpu"):
            use = True
            why = "dxvk.conf" if forced else f"Direct3D {ver}"
            if not os.path.isdir(os.path.join(DXVK, "x32")):
                log(f"DXVK would help ({why}), but it is not in {DXVK} (run install.sh)")
                use = False
        elif forced:
            log("dxvk.conf names this program, but there is no Vulkan for DXVK")
    if not use:
        if ours:                                  # placed earlier: make Wine ignore them this time
            e = dict(e)
            names = ",".join(n[:-4] for n in ours)
            e["WINEDLLOVERRIDES"] = f"{names}=b" + (";" + e["WINEDLLOVERRIDES"] if e.get("WINEDLLOVERRIDES") else "")
        return e
    src = os.path.join(DXVK, "x64" if kind(path)[0] == "win64" else "x32")
    placed = []
    for n in DXVK_DLLS:
        s_, t_ = os.path.join(src, n + ".dll"), os.path.join(d, n + ".dll")
        if not os.path.exists(s_) or (os.path.exists(t_) and n + ".dll" not in ours):
            continue                              # not in DXVK, or the program brings its own
        try:
            if not os.path.exists(t_):
                shutil.copyfile(s_, t_)
            placed.append(n + ".dll")
        except OSError as err:
            log(f"DXVK: {n}.dll not placed next to the program ({err})")
    if not placed:
        return e
    if set(placed) != ours:
        try:
            with open(mark, "w") as f:
                f.write("# DLLs placed by exe-handler for DXVK. Delete them and this file, or create\n"
                        "# exe-handler.no-dxvk here, to use Wine's own Direct3D again.\n")
                f.write("\n".join(placed) + "\n")
        except OSError:
            pass
        log(f"DXVK placed in {d}: {', '.join(placed)}")
    e = dict(e)
    names = ",".join(p[:-4] for p in placed)
    e["WINEDLLOVERRIDES"] = f"{names}=n,b" + (";" + e["WINEDLLOVERRIDES"] if e.get("WINEDLLOVERRIDES") else "")
    e.setdefault("DXVK_LOG_LEVEL", "warn")       # 'info' writes hundreds of lines per start
    if "DXVK_FILTER_DEVICE_NAME" not in e and vulkan_for_dxvk() == "llvmpipe":
        e["DXVK_FILTER_DEVICE_NAME"] = "llvmpipe"
        log(f"DXVK for {why}: the GPU cannot run it, so software Vulkan (llvmpipe): slow, but it runs")
    else:
        log(f"DXVK for {why}")
    return e


def run_wine(path, args, console, msi=False, prefix=None, e=None):
    if not page_size_ok():
        return 1
    if not shutil.which(WINE[0]):
        tell(T("Wine is not installed. Run install.sh from exe-handler first.",
               "Wine is niet geïnstalleerd. Draai eerst install.sh van exe-handler."), error=True)
        return 1
    e = e or env_wine()
    if not prefix_ready(e):
        tell(T("Could not prepare Wine. See ~/.cache/exe-handler.log",
               "Wine kon niet worden klaargezet. Zie ~/.cache/exe-handler.log"), error=True)
        return 1
    keep_wine_ready(e)
    path, start_opts = start_line(path)
    args = start_opts + list(args)
    auto_settings(path, e)
    reg = next_to(path, "exe-handler.reg", "run-exe.reg")
    if reg:
        wine("regedit", "/S", "Z:" + reg.replace("/", "\\"), e=e)
        log(f"registry imported: {reg}")
    extra = runtime_in_parent(path) if is_visual_basic(path) else None
    if kind(path)[0] == "win16":
        if extra:
            win16_runtimes(extra, e)
        win16_shared(path, e)
    elif extra:
        e = dict(e)
        e["WINEPATH"] = extra + (";" + e["WINEPATH"] if e.get("WINEPATH") else "")
        log(f"runtime DLLs found one folder up: WINEPATH={extra}")
    chosen = None if (prefix or msi) else virtual_desktop(path)     # from virtual-desktop.conf: keep that size
    size = chosen or (None if (prefix or msi) else auto_desktop(path))
    if not (prefix or msi):
        e = ddraw_compat(path, e, cnc=not size)
    if not (size or prefix or msi):
        e = cnc_ddraw(path, e)
    if not (prefix or msi):
        e = dxvk(path, e)
    if (size or listed("x11.conf", path)) and e.get("DISPLAY") and e.get("WAYLAND_DISPLAY"):
        # Wine's Wayland driver has no virtual desktop, and some games need X11 for the mouse: use the X11 driver
        # Without WAYLAND_DISPLAY Wine's Wayland driver still finds the default socket (wayland-0); its half-failed
        # start then makes the X11 driver fail to load under Box64 ("no driver could be loaded"). Switch it off.
        e = dict(e)
        e.pop("WAYLAND_DISPLAY")
        e["WINEDLLOVERRIDES"] = "winewayland.drv=d" + (";" + e["WINEDLLOVERRIDES"] if e.get("WINEDLLOVERRIDES") else "")
        log("Wine X11 driver for this program (virtual desktop or listed in x11.conf)")
    if size:
        name = os.path.splitext(os.path.basename(path))[0]
        prefix = ["explorer", f"/desktop={name},{size}"]
        log(f"virtual desktop {size}")
        fit_desktop(name, size, fit=not chosen)
    cmd = WINE + (prefix or []) + (["msiexec", "/i"] if msi else []) + [path] + args
    cwd = os.path.dirname(path)
    log("run " + shlex.join(cmd))
    if console and sys.stdin.isatty():
        return subprocess.run(cmd, cwd=cwd, env=e).returncode
    if console:
        cmd = terminal(cmd)
    start = time.time()
    before = monitors()
    try:
        with open(LOG, "a") as lf:
            rc = subprocess.run(cmd, cwd=cwd, env=e, stdout=lf, stderr=lf).returncode
            if rc is not None and -rc in (4, 6, 7, 11) and time.time() - start < 30:
                # killed by a signal right after the start: on ARM mostly Box64 tripping over a first start
                # (Unity games); a second start nearly always works
                log(f"wine was killed by signal {-rc} after {time.time() - start:.0f}s: starting once more")
                start = time.time()
                rc = subprocess.run(cmd, cwd=cwd, env=e, stdout=lf, stderr=lf).returncode
    finally:
        restore_monitors(before)
    log(f"wine finished rc={rc} after {time.time() - start:.0f}s")
    if rc not in (0, None) and time.time() - start < 5:
        missing = [] if (prefix or msi) else missing_dlls(path, e)
        if missing:
            names, where = ", ".join(m.upper() for m in missing), system_dir(path, e)
            log(f"missing DLL(s): {names}")
            tell(T(f"{os.path.basename(path)} cannot start: {names} is missing. Put that file next to the program "
                   f"or in {where} (it often comes with the program's installer or with Windows 95/98).",
                   f"{os.path.basename(path)} kan niet starten: {names} ontbreekt. Zet dat bestand naast het "
                   f"programma of in {where} (het zit vaak in de installer van het programma of in Windows 95/98)."),
                 error=True)
            return rc
        tell(T(f"{os.path.basename(path)} stopped right away (code {rc}). See ~/.cache/exe-handler.log",
               f"{os.path.basename(path)} stopte meteen (code {rc}). Zie ~/.cache/exe-handler.log"), error=True)
    return rc


def run_win16(path, args):
    """16-bit Windows. x86 Wine runs it itself; on ARM Box64 cannot, so otvdm emulates the 16-bit CPU."""
    if IS_X86 or not OTVDM or not os.path.exists(os.path.join(OTVDM, "otvdmw.exe")):
        return run_wine(path, args, False)
    e = env_wine()
    dlls = os.path.join(OTVDM, "dll")
    if os.path.isdir(dlls):
        e["WINEDLLOVERRIDES"] = ",".join(sorted(n for n in os.listdir(dlls) if n.lower().endswith("16"))) + "=n"
    return run_wine(path, args, False, prefix=["Z:" + os.path.join(OTVDM, "otvdmw.exe").replace("/", "\\")], e=e)


DOS_CONF = """# DOSBox-X settings for exe-handler (DOS programs and games). Edit freely.
# The mouse is caught when you click in the window (needed for games like Doom); Ctrl+F10 lets it go.
# Alt+Enter or F12+F = fullscreen on/off (F12 is the DOSBox-X host key; exe-handler passes Alt+Enter on as F12+F). The window can be resized and maximised;
# the picture scales along. With "cycles = auto" exe-handler picks a speed from the age of the program
# (see dos_cycles in exe-handler); set a number here (e.g. cycles = 8000) to fix the speed yourself.
[sdl]
autolock         = true
showmenu         = false
fullresolution   = desktop
windowresolution = original
output           = opengl
[dosbox]
quit warning = false
machine = svga_s3
memsize = 32
[cpu]
core    = auto
cputype = auto
cycles  = auto
[sblaster]
sbtype = sb16
[render]
aspect = true
scaler = normal2x
"""


def dos_safe_dir(d):
    """DOSBox(-X) cuts a mount path at ':' (and DOSBox at some other characters). Folders on a network share
    opened in the file manager look like /run/user/1000/gvfs/smb-share:server=nas,share=games/..., so mount
    such a folder through a plain symlink in ~/.cache/exe-handler/dos/."""
    if not any(c in d for c in ':"'):
        return d
    import hashlib
    links = f"{HOME}/.cache/exe-handler/dos"
    os.makedirs(links, exist_ok=True)
    safe = "".join(c if c.isalnum() else "_" for c in os.path.basename(d))[:24] or "dir"
    link = os.path.join(links, f"{safe}-{hashlib.sha1(d.encode()).hexdigest()[:8]}")
    if not os.path.islink(link):
        os.symlink(d, link)
    log(f"mount through link {link} -> {d}")
    return link


def conf_has(conf, key):
    try:
        return any(l.split("=")[0].strip() == key for l in open(conf))
    except OSError:
        return False


SOUNDFONTS = ("/usr/share/sounds/sf2/FluidR3_GM.sf2", "/usr/share/sounds/sf2/default-GM.sf2",
              "/usr/share/soundfonts/default.sf2", "/usr/share/soundfonts/FluidR3_GM.sf2",
              "/usr/share/sounds/sf2/TimGM6mb.sf2", "/usr/share/soundfonts/TimGM6mb.sf2")


def dos_midi(conf):
    """Games set up for General MIDI music stay silent when DOSBox-X has no sound font; it does not look in the
    places where Linux distributions install one. Point it to the first one found (unless dos.conf has its own)."""
    if conf_has(conf, "mididevice") or conf_has(conf, "fluid.soundfont"):
        return []
    sf = next((f for f in SOUNDFONTS if os.path.exists(f)), None)
    if not sf:
        return []
    return ["-set", "midi mididevice=fluidsynth", "-set", f"midi fluid.soundfont={sf}"]


def dos_conf_update(conf):
    """dos.conf written by an earlier exe-handler had autolock = false: games that steer with the mouse (Doom)
    did not get it. Change that line once; a file the user changed further keeps everything else."""
    try:
        text = open(conf).read()
    except OSError:
        return
    old = "autolock         = false\n"
    if text.startswith("# DOSBox-X settings for exe-handler") and old in text and "# autolock: keep" not in text:
        with open(conf, "w") as f:
            f.write(text.replace(old, "autolock         = true\n# autolock: keep  (Ctrl+F10 releases the mouse; write false above to never catch it)\n"))
        log("dos.conf: autolock set to true (mouse is caught on click, Ctrl+F10 releases)")


def dated_program(path):
    """The file whose date tells the age of a DOS program. A .bat file is often written later (or by hand):
    use the .exe/.com it starts from its own folder, else the oldest .exe/.com there."""
    if not path.lower().endswith(".bat"):
        return path
    d = os.path.dirname(path)
    try:
        progs = [n for n in os.listdir(d) if n.lower().endswith((".exe", ".com"))]
        words = set(re.findall(r"[a-z0-9_~!$-]+", open(path, errors="replace").read().lower()))
    except OSError:
        return path
    named = [n for n in progs if os.path.splitext(n)[0].lower() in words]
    pick = named or progs
    if not pick:
        return path
    return min((os.path.join(d, n) for n in pick), key=os.path.getmtime)


def dos_cycles(path, conf):
    """Speed for real-mode DOS programs. DOSBox's own 'auto' gives them 3000 cycles (a slow 286), which is right
    for games from the 1980s but far too slow for 1990s games. Guess from the date of the program file;
    protected-mode games (DOS4GW etc.) get 90% of what the computer can do. Only when dos.conf says cycles = auto."""
    try:
        own = [l.split("=", 1)[1].strip() for l in open(conf) if l.split("=")[0].strip() == "cycles"]
    except OSError:
        own = []
    if own and own[-1] != "auto":
        return None
    year = time.localtime(os.path.getmtime(dated_program(path))).tm_year
    if year < 1989:
        n = 3000
    elif year < 1992:
        n = 6000
    elif year < 1994:
        n = 12000
    elif year < 2000:
        n = 20000
    else:
        n = 12000          # date unknown (file copied without its date)
    log(f"DOS speed: program dated {year} -> cycles auto {n} 90%")
    return f"auto {n} 90%"


def alt_enter_fullscreen(pid):
    """Alt+Enter = fullscreen on/off, as people expect from DOS games. DOSBox-X has it on F12+F, and a key file
    that only adds Alt+Enter switches all other keys off. So: catch Alt+Enter while the DOSBox-X window has the
    keyboard and press F12+F for it. X11 (also XWayland), needs wmctrl and libXtst; silently nothing otherwise."""
    if not (os.environ.get("DISPLAY") and shutil.which("wmctrl")):
        return
    import ctypes, threading

    def work():
        try:
            X = ctypes.cdll.LoadLibrary("libX11.so.6")
            T = ctypes.cdll.LoadLibrary("libXtst.so.6")
        except OSError:
            return
        X.XOpenDisplay.restype = ctypes.c_void_p
        X.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        X.XGrabKey.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_uint, ctypes.c_ulong] + [ctypes.c_int] * 3
        X.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
        X.XUngrabKeyboard.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        X.XFlush.argtypes = [ctypes.c_void_p]
        X.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        X.XSetErrorHandler.argtypes = [ctypes.c_void_p]
        T.XTestFakeKeyEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
        handler = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)(lambda d, e: 0)
        X.XSetErrorHandler(handler)                   # a window that is gone must not end exe-handler
        d = ctypes.c_void_p(X.XOpenDisplay(None))
        if not d:
            return
        win = None
        for _ in range(60):
            try:
                rows = subprocess.run(["wmctrl", "-lp"], capture_output=True, text=True, timeout=5).stdout.splitlines()
            except (OSError, subprocess.TimeoutExpired):
                return
            ids = [r.split()[0] for r in rows if len(r.split()) > 2 and r.split()[2] == str(pid)]
            if ids:
                win = int(ids[-1], 16)
                break
            time.sleep(0.5)
        if not win:
            return
        ret, f12, kf = (X.XKeysymToKeycode(d, k) for k in (0xff0d, 0xffc9, 0x66))      # Return, F12, f
        for lock in (0, 2, 16, 18):                   # with and without Caps Lock (2) and Num Lock (16)
            X.XGrabKey(d, ret, 8 | lock, win, 0, 1, 1)                                 # 8 = Alt
        X.XSync(d, 0)
        log("Alt+Enter switches DOSBox-X fullscreen (sent as F12+F)")
        ev = ctypes.create_string_buffer(192)
        while True:
            X.XNextEvent(d, ev)
            if ctypes.cast(ev, ctypes.POINTER(ctypes.c_int))[0] != 2:                  # KeyPress
                continue
            X.XUngrabKeyboard(d, 0)
            X.XSync(d, 0)
            time.sleep(0.05)
            for key, down, wait in ((f12, 1, 0.15), (kf, 1, 0.08), (kf, 0, 0.15), (f12, 0, 0)):
                T.XTestFakeKeyEvent(d, key, down, 0)
                X.XFlush(d)
                time.sleep(wait)

    threading.Thread(target=work, daemon=True).start()


def run_dos(path, args):
    if not shutil.which(DOSBOX[0]):
        tell(T("DOSBox is not installed. Run install.sh from exe-handler first.",
               "DOSBox is niet geïnstalleerd. Draai eerst install.sh van exe-handler."), error=True)
        return 1
    conf = os.path.join(USER_DIR, "dos.conf")
    if not os.path.exists(conf):
        os.makedirs(USER_DIR, exist_ok=True)
        with open(conf, "w") as f:
            f.write(DOS_CONF)
    d, name = os.path.split(path)
    d = dos_safe_dir(d)
    run = " ".join([f'"{name}"' if " " in name else name] + args)
    x = any("dosbox-x" in w.lower() for w in DOSBOX)
    dos_conf_update(conf)
    cyc = dos_cycles(path, conf)
    cmd = DOSBOX + (["-conf", conf, "-fastlaunch", "-nopromptfolder"] if x else []) + \
        (["-set", f"cpu cycles={cyc}"] if x and cyc else []) + \
        (["-set", "dosbox quit warning=false"] if x and not conf_has(conf, "quit warning") else []) + \
        (dos_midi(conf) if x else []) + \
        ["-c", f'mount c "{d}"', "-c", "c:", "-c", run, "-c", "exit"]
    log("run " + shlex.join(cmd))
    with open(LOG, "a") as lf:
        proc = subprocess.Popen(cmd, cwd=d, stdout=lf, stderr=lf)
        if x and len(DOSBOX) == 1:                    # not for a Flatpak DOSBox-X: its process id is another one
            alt_enter_fullscreen(proc.pid)
        return proc.wait()


def kernel_mount_path(path):
    """A file opened from a network share in the file manager has a path like
    /run/user/1000/gvfs/smb-share:server=nas,share=games/dir/GAME.EXE. That gvfs layer cannot change an existing
    file in place ('Operation not supported'): a DOS setup that patches its driver files, or a game that updates a
    save file, then fails silently. If the same share is also mounted by the kernel (cifs, e.g. /mnt/nas), use that
    path instead; there everything works."""
    import re
    m = re.match(r"(/run/user/\d+/gvfs|.*/\.gvfs)/smb-share:([^/]*)(/.*)?$", path)
    if not m:
        return path
    opts = dict(o.split("=", 1) for o in m.group(2).split(",") if "=" in o)
    server, share, rest = opts.get("server", "").lower(), opts.get("share", "").lower(), m.group(3) or ""
    short = lambda h: h.split(".")[0]
    try:
        mounts = [l.split() for l in open("/proc/mounts")]
    except OSError:
        return path
    for f in mounts:
        if len(f) > 2 and f[2] in ("cifs", "smb3", "smbfs") and f[0].startswith("//"):
            host, _, sh = f[0][2:].partition("/")
            if sh.lower().rstrip("/") == share and (host.lower() == server or short(host.lower()) == short(server)):
                cand = f[1].replace("\\040", " ") + rest
                if os.path.exists(cand):
                    log(f"network share: using the kernel mount {f[1]} instead of the file manager's gvfs path")
                    return cand
    log("network share opened through the file manager (gvfs): programs cannot change existing files there; "
        "mount the share with cifs (e.g. in /etc/fstab) if a program needs to save settings")
    return path


def check(path):
    """exe-handler --check FILE: what would happen, for troubleshooting."""
    path = os.path.abspath(path)
    if not os.path.isfile(path):
        print(T(f"File not found: {path}", f"Bestand niet gevonden: {path}"))
        return 1
    k, console = kind(path)
    target = alias(path)
    print(f"file          {path}")
    print(f"type          {k}{' (console)' if console else ''}")
    print(f"start         {target}" + ("" if target == path else "  (exe-handler.start)"))
    print(f"Visual Basic  {'yes' if is_visual_basic(target) else 'no'}")
    size = screen_size()
    print(f"screen        {size[0]}x{size[1] if size else ''}" if size else "screen        unknown")
    vd = virtual_desktop(target) or (auto_desktop(target) if k not in ("dos", "bat", "msi") else None)
    print(f"virtual desk  {vd or 'no'}")
    if k.startswith("win"):
        ver, forced = direct3d_version(target), listed("dxvk.conf", target)
        off = listed("no-dxvk.conf", target) or next_to(target, "exe-handler.no-dxvk")
        mode = vulkan_for_dxvk() if (ver or forced) else None
        on = bool(mode) and not off and (forced or ver == 11 or mode == "gpu")
        print(f"Direct3D      {ver or 'no'}" + (f"  -> DXVK ({mode})" if on else "  -> Wine's own" if ver else ""))
    print(f"wine          {shlex.join(WINE)}  ({'found' if shutil.which(WINE[0]) else 'NOT FOUND'})")
    print(f"settings      {CONF}  ({'found' if os.path.exists(CONF) else 'not found'})")
    if shutil.which("xdg-mime"):
        mt = subprocess.run(["xdg-mime", "query", "filetype", path], capture_output=True, text=True).stdout.strip()
        app = subprocess.run(["xdg-mime", "query", "default", mt], capture_output=True, text=True).stdout.strip() if mt else ""
        print(f"double click  {mt} -> {app or '(no default)'}" + ("" if app == "exe-handler.desktop" else
              T("   <- not exe-handler: run install.sh again", "   <- niet exe-handler: draai install.sh opnieuw")))
    return 0


def main():
    a = sys.argv[1:]
    if a and a[0] == "--warmup":
        if shutil.which(WINE[0]) and page_size_ok():
            keep_wine_ready(env_wine(), warm=True)
        return 0
    if a and a[0] == "--check":
        return check(a[1] if len(a) > 1 else "")
    force = a.pop(0)[2:] if a and a[0] in ("--dos", "--wine") else None
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if a else 2
    path = kernel_mount_path(os.path.abspath(a[0]))
    args = a[1:]
    if not os.path.isfile(path):
        tell(T(f"File not found: {path}", f"Bestand niet gevonden: {path}"), error=True)
        return 1
    k, console = kind(path)
    log(f"start {path} type={k} console={console} choice={force or 'auto'}")
    own_prefix(path)
    if force == "dos" or (not force and k in ("dos", "bat")):
        return run_dos(path, args)
    if not force and k == "win16":
        return run_win16(path, args)
    return run_wine(path, args, console, msi=(k == "msi"))


if __name__ == "__main__":
    sys.exit(main())
