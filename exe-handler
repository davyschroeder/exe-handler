def dos_safe_dir(d):
    """DOSBox(-X) cuts a mount path at ':' (and DOSBox at some other characters). Folders on a network share
    opened in the file manager look like /run/user/1000/gvfs/smb-share:server=nas,share=games/..., so mount
    such a folder through a plain symlink in ~/.cache/exe-handler/dos/."""
    if not any(c in d for c in ':"'):
        return d
    import hashlib
    links = f"{HOME}/.cache/exe-handler/dos"
    os.makedirs(links, exist_ok=True)
    safe = "".join(c if c.isalnum() else "_" for c in os.path.basename(d))[:24] or "dir"
    link = os.path.join(links, f"{safe}-{hashlib.sha1(d.encode()).hexdigest()[:8]}")
    if not os.path.islink(link):
        os.symlink(d, link)
    log(f"mount through link {link} -> {d}")
    return link


def conf_has(conf, key):
    try:
        return any(l.split("=")[0].strip() == key for l in open(conf))
    except OSError:
        return False


SOUNDFONTS = ("/usr/share/sounds/sf2/FluidR3_GM.sf2", "/usr/share/sounds/sf2/default-GM.sf2",
              "/usr/share/soundfonts/default.sf2", "/usr/share/soundfonts/FluidR3_GM.sf2",
              "/usr/share/sounds/sf2/TimGM6mb.sf2", "/usr/share/soundfonts/TimGM6mb.sf2")


def dos_midi(conf):
    """Games set up for General MIDI music stay silent when DOSBox-X has no sound font; it does not look in the
    places where Linux distributions install one. Point it to the first one found (unless dos.conf has its own)."""
    if conf_has(conf, "mididevice") or conf_has(conf, "fluid.soundfont"):
        return []
    sf = next((f for f in SOUNDFONTS if os.path.exists(f)), None)
    if not sf:
        return []
    return ["-set", "midi mididevice=fluidsynth", "-set", f"midi fluid.soundfont={sf}"]


def dos_conf_update(conf):
    """dos.conf written by an earlier exe-handler had autolock = false: games that steer with the mouse (Doom)
    did not get it. Change that line once; a file the user changed further keeps everything else."""
    try:
        text = open(conf).read()
    except OSError:
        return
    old = "autolock         = false\n"
    if text.startswith("# DOSBox-X settings for exe-handler") and old in text and "# autolock: keep" not in text:
        with open(conf, "w") as f:
            f.write(text.replace(old, "autolock         = true\n# autolock: keep  (Ctrl+F10 releases the mouse; write false above to never catch it)\n"))
        log("dos.conf: autolock set to true (mouse is caught on click, Ctrl+F10 releases)")


def dos_cycles(path, conf):
    """Speed for real-mode DOS programs. DOSBox's own 'auto' gives them 3000 cycles (a slow 286), which is right
    for games from the 1980s but far too slow for 1990s games. Guess from the date of the program file;
    protected-mode games (DOS4GW etc.) get 90% of what the computer can do. Only when dos.conf says cycles = auto."""
    try:
        own = [l.split("=", 1)[1].strip() for l in open(conf) if l.split("=")[0].strip() == "cycles"]
    except OSError:
        own = []
    if own and own[-1] != "auto":
        return None
    year = time.localtime(os.path.getmtime(path)).tm_year
    if year < 1989:
        n = 3000
    elif year < 1992:
        n = 6000
    elif year < 1994:
        n = 12000
    elif year < 2000:
        n = 20000
    else:
        n = 12000          # date unknown (file copied without its date)
    log(f"DOS speed: program dated {year} -> cycles auto {n} 90%")
    return f"auto {n} 90%"


def alt_enter_fullscreen(pid):
    """Alt+Enter = fullscreen on/off, as people expect from DOS games. DOSBox-X has it on F12+F, and a key file
    that only adds Alt+Enter switches all other keys off. So: catch Alt+Enter while the DOSBox-X window has the
    keyboard and press F12+F for it. X11 (also XWayland), needs wmctrl and libXtst; silently nothing otherwise."""
    if not (os.environ.get("DISPLAY") and shutil.which("wmctrl")):
        return
    import ctypes, threading

    def work():
        try:
            X = ctypes.cdll.LoadLibrary("libX11.so.6")
            T = ctypes.cdll.LoadLibrary("libXtst.so.6")
        except OSError:
            return
        X.XOpenDisplay.restype = ctypes.c_void_p
        X.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        X.XGrabKey.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_uint, ctypes.c_ulong] + [ctypes.c_int] * 3
        X.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
        X.XUngrabKeyboard.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        X.XFlush.argtypes = [ctypes.c_void_p]
        X.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        X.XSetErrorHandler.argtypes = [ctypes.c_void_p]
        T.XTestFakeKeyEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
        handler = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)(lambda d, e: 0)
        X.XSetErrorHandler(handler)                   # a window that is gone must not end exe-handler
        d = ctypes.c_void_p(X.XOpenDisplay(None))
        if not d:
            return
        win = None
        for _ in range(60):
            try:
                rows = subprocess.run(["wmctrl", "-lp"], capture_output=True, text=True, timeout=5).stdout.splitlines()
            except (OSError, subprocess.TimeoutExpired):
                return
            ids = [r.split()[0] for r in rows if len(r.split()) > 2 and r.split()[2] == str(pid)]
            if ids:
                win = int(ids[-1], 16)
                break
            time.sleep(0.5)
        if not win:
            return
        ret, f12, kf = (X.XKeysymToKeycode(d, k) for k in (0xff0d, 0xffc9, 0x66))      # Return, F12, f
        for lock in (0, 2, 16, 18):                   # with and without Caps Lock (2) and Num Lock (16)
            X.XGrabKey(d, ret, 8 | lock, win, 0, 1, 1)                                 # 8 = Alt
        X.XSync(d, 0)
        log("Alt+Enter switches DOSBox-X fullscreen (sent as F12+F)")
        ev = ctypes.create_string_buffer(192)
        while True:
            X.XNextEvent(d, ev)
            if ctypes.cast(ev, ctypes.POINTER(ctypes.c_int))[0] != 2:                  # KeyPress
                continue
            X.XUngrabKeyboard(d, 0)
            X.XSync(d, 0)
            time.sleep(0.05)
            for key, down, wait in ((f12, 1, 0.15), (kf, 1, 0.08), (kf, 0, 0.15), (f12, 0, 0)):
                T.XTestFakeKeyEvent(d, key, down, 0)
                X.XFlush(d)
                time.sleep(wait)

    threading.Thread(target=work, daemon=True).start()


def run_dos(path, args):
    if not shutil.which(DOSBOX[0]):
        tell(T("DOSBox is not installed. Run install.sh from exe-handler first.",
               "DOSBox is niet geïnstalleerd. Draai eerst install.sh van exe-handler."), error=True)
        return 1
    conf = os.path.join(USER_DIR, "dos.conf")
    if not os.path.exists(conf):
        os.makedirs(USER_DIR, exist_ok=True)
        with open(conf, "w") as f:
            f.write(DOS_CONF)
    d, name = os.path.split(path)
    d = dos_safe_dir(d)
    run = " ".join([f'"{name}"' if " " in name else name] + args)
    x = any("dosbox-x" in w.lower() for w in DOSBOX)
    dos_conf_update(conf)
    cyc = dos_cycles(path, conf)
    cmd = DOSBOX + (["-conf", conf, "-fastlaunch", "-nopromptfolder"] if x else []) + \
        (["-set", f"cpu cycles={cyc}"] if x and cyc else []) + \
        (["-set", "dosbox quit warning=false"] if x and not conf_has(conf, "quit warning") else []) + \
        (dos_midi(conf) if x else []) + \
        ["-c", f'mount c "{d}"', "-c", "c:", "-c", run, "-c", "exit"]
    log("run " + shlex.join(cmd))
    with open(LOG, "a") as lf:
        proc = subprocess.Popen(cmd, cwd=d, stdout=lf, stderr=lf)
        if x and len(DOSBOX) == 1:                    # not for a Flatpak DOSBox-X: its process id is another one
            alt_enter_fullscreen(proc.pid)
        return proc.wait()


def check(path):
    """exe-handler --check FILE: what would happen, for troubleshooting."""
    path = os.path.abspath(path)
    if not os.path.isfile(path):
        print(T(f"File not found: {path}", f"Bestand niet gevonden: {path}"))
        return 1
    k, console = kind(path)
    target = alias(path)
    print(f"file          {path}")
    print(f"type          {k}{' (console)' if console else ''}")
    print(f"start         {target}" + ("" if target == path else "  (exe-handler.start)"))
    print(f"Visual Basic  {'yes' if is_visual_basic(target) else 'no'}")
    size = screen_size()
    print(f"screen        {size[0]}x{size[1] if size else ''}" if size else "screen        unknown")
    vd = virtual_desktop(target) or (auto_desktop(target) if k not in ("dos", "bat", "msi") else None)
    print(f"virtual desk  {vd or 'no'}")
    print(f"wine          {shlex.join(WINE)}  ({'found' if shutil.which(WINE[0]) else 'NOT FOUND'})")
    print(f"settings      {CONF}  ({'found' if os.path.exists(CONF) else 'not found'})")
    if shutil.which("xdg-mime"):
        mt = subprocess.run(["xdg-mime", "query", "filetype", path], capture_output=True, text=True).stdout.strip()
        app = subprocess.run(["xdg-mime", "query", "default", mt], capture_output=True, text=True).stdout.strip() if mt else ""
        print(f"double click  {mt} -> {app or '(no default)'}" + ("" if app == "exe-handler.desktop" else
              T("   <- not exe-handler: run install.sh again", "   <- niet exe-handler: draai install.sh opnieuw")))
    return 0


def main():
    a = sys.argv[1:]
    if a and a[0] == "--warmup":
        if shutil.which(WINE[0]) and page_size_ok():
            keep_wine_ready(env_wine(), warm=True)
        return 0
    if a and a[0] == "--check":
        return check(a[1] if len(a) > 1 else "")
    force = a.pop(0)[2:] if a and a[0] in ("--dos", "--wine") else None
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if a else 2
    path = os.path.abspath(a[0])
    args = a[1:]
    if not os.path.isfile(path):
        tell(T(f"File not found: {path}", f"Bestand niet gevonden: {path}"), error=True)
        return 1
    k, console = kind(path)
    log(f"start {path} type={k} console={console} choice={force or 'auto'}")
    if force == "dos" or (not force and k in ("dos", "bat")):
        return run_dos(path, args)
    if not force and k == "win16":
        return run_win16(path, args)
    return run_wine(path, args, console, msi=(k == "msi"))


if __name__ == "__main__":
    sys.exit(main())
